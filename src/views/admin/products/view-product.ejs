<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no" />
    <meta name="description" content="Hỏi Dân IT - Dự án laptopshop" />
    <meta name="author" content="Hỏi Dân IT" />
    <title>Dashboard - Hỏi Dân IT</title>
    <link href="/admin/css/styles.css" rel="stylesheet" />
    <script src="https://use.fontawesome.com/releases/v6.3.0/js/all.js" crossorigin="anonymous"></script>
    <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
    <script>
        $(document).ready(() => {
            const avatarFile = $("#avatarFile");
            avatarFile.change(function (e) {
                const imgURL = URL.createObjectURL(e.target.files[0]);
                $("#avatarPreview").attr("src", imgURL);
                $("#avatarPreview").css({ "display": "block" });
            });
        });
    </script>

</head>

<body class="sb-nav-fixed">
    <%- include('../layout/header.ejs'); -%>
        <div id="layoutSidenav">
            <div id="layoutSidenav_nav">
                <%- include('../layout/sidebar.ejs'); -%>
            </div>
            <div id="layoutSidenav_content">
                <main>
                    <div class="container-fluid px-4">
                        <h1 class="mt-4">Manage Users</h1>
                        <ol class="breadcrumb mb-4">
                            <li class="breadcrumb-item active">Products</li>
                        </ol>
                        <div style="width: 600px; margin: auto">
                            <h3 style="padding: 10px 0;">View detail a product</h3>
                            <form action="/admin/handle-update-product" method="post" enctype="multipart/form-data">
                                <input value="<%= product.id %>" name="id" type="hidden" class="form-control">
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label class="form-label">Name: </label>
                                        <input value="<%= product.name %>" name="name" type="text" class="form-control"
                                            placeholder="Your name">
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label class="form-label">Price: </label>
                                        <input value="<%= product.price %>" name="price" type="text"
                                            class="form-control">
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="inputCity" class="form-label">Detail Description</label>
                                    <textarea class="form-control" name="detailDesc"
                                        rows="2"><%= product.detailDesc %></textarea>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-md-6">
                                        <label for="inputCity" class="form-label">Short Description:</label>
                                        <input value="<%= product.shortDesc %>" type="text" class="form-control"
                                            name="shortDesc">
                                    </div>
                                    <div class="mb-3 col-md-6">
                                        <label for="inputCity" class="form-label">Quantity:</label>
                                        <input value="<%= product.quantity %>" type="text" class="form-control"
                                            name="quantity">
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="mb-3 col-6">
                                        <label class="form-label">Factory</label>
                                        <select name="factory" class="form-select">
                                            <% factoryOptions.forEach((factoryOption,index)=> { %>
                                                <option value="<%-factoryOption.value %>"
                                                    <%=factoryOption.value===product.factory ? 'selected' : '' %>%>>
                                                    <%- factoryOption.name %>
                                                </option>
                                                <%})%>
                                        </select>
                                    </div>
                                    <div class="mb-3 col-6">
                                        <label class="form-label">Target</label>
                                        <select name="target" class="form-select">
                                            <% targetOptions.forEach((target,index)=> { %>
                                                <option value="<%-target.value %>" <%=target.value===product.target
                                                    ? 'selected' : '' %>%>>
                                                    <%- target.name %>
                                                </option>
                                                <%})%>
                                        </select>
                                    </div>
                                </div>
                                <div class="mb-3">
                                    <label for="formFile" class="form-label">Image</label>
                                    <input name="avatarProduct" class="form-control" type="file" id="avatarFile"
                                        accept=".png, .jpg, .jpeg">
                                    <% if (product.image) { %>
                                        <img style="max-height: 250px; display: block;" alt="avatar preview"
                                            id="avatarPreview" src="/images/product/<%= product.image %> " />
                                        <% } else { %>
                                            <img style="max-height: 250px; display: none;" alt="avatar preview"
                                                id="avatarPreview" />
                                            <% } %>
                                </div>
                                <img style="max-height: 250px; display: none;" alt="avatar preview"
                                    id="avatarPreview" />
                                <div class="mb-3">
                                    <button type="submit" class="btn btn-primary">Submit</button>
                                </div>
                            </form>
                        </div>
                </main>
                <%- include('../layout/footer.ejs'); -%>
            </div>
        </div>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.3/dist/js/bootstrap.bundle.min.js"
            crossorigin="anonymous"></script>
        <script src="/admin/js/scripts.js"></script>
</body>

</html>